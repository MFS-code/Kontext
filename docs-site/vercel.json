{
  "redirects": [
    {
      "source": "/",
      "destination": "/docs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/quickstart",
      "destination": "/docs/quickstart/index.html"
    },
    {
      "source": "/docs/resources",
      "destination": "/docs/resources/index.html"
    },
    {
      "source": "/docs/task-workload",
      "destination": "/docs/task-workload/index.html"
    },
    {
      "source": "/docs/scheduled-workload",
      "destination": "/docs/scheduled-workload/index.html"
    },
    {
      "source": "/docs/service-workload",
      "destination": "/docs/service-workload/index.html"
    },
    {
      "source": "/docs/operations",
      "destination": "/docs/operations/index.html"
    },
    {
      "source": "/docs/releases",
      "destination": "/docs/releases/index.html"
    },
    {
      "source": "/docs/runtimes",
      "destination": "/docs/runtimes/index.html"
    },
    {
      "source": "/docs/evals",
      "destination": "/docs/evals/index.html"
    },
    {
      "source": "/SPEC",
      "destination": "/SPEC/index.html"
    },
    {
      "source": "/docs/when-not-to-use-agents",
      "destination": "/docs/when-not-to-use-agents/index.html"
    },
    {
      "source": "/((?!assets/|raw/|llms\\.txt$|llms-full\\.txt$|robots\\.txt$|sitemap\\.xml$|favicon\\.svg$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/raw/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
